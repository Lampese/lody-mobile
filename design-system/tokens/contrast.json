    ["state.done", "bg.base", 3],
    ["state.failed", "bg.base", 3],
    ["state.merged", "bg.base", 3],
    ["pr.open", "bg.base", 3],
    ["pr.merged", "bg.base", 3],
    ["pr.closed", "bg.base", 3],
    ["pr.draft", "bg.base", 3],
    ["label.gray.fg", "label.gray.bg", 4.5],
    ["label.red.fg", "label.red.bg", 4.5],
    ["label.orange.fg", "label.orange.bg", 4.5],
    ["label.yellow.fg", "label.yellow.bg", 4.5],
    ["label.green.fg", "label.green.bg", 4.5],
    ["label.teal.fg", "label.teal.bg", 4.5],
    ["label.blue.fg", "label.blue.bg", 4.5],
