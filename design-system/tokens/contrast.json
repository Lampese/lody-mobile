{
  "$description": "Accessibility floors checked by scripts/check.mjs in both modes. pairs: WCAG contrast (4.5 body text, 3 large text and glyphs); a translucent background is composited onto every surface below and the worst case must pass. separation: tinted fills must differ from every surface by at least minDeltaL (OKLCH lightness) so they stay visible on lists, grouped backgrounds and cards alike.",
  "surfaces": [
    "bg.base",
    "bg.grouped",
    "bg.raised"
  ],
  "separation": {
    "minDeltaL": 0.03,
    "tokens": [
      "fill.secondary",
      "fill.tertiary",
      "fill.selected",
      "bg.sunken",
      "accent.subtle",
      "danger.subtle",
      "warning.subtle",
      "success.subtle",
      "info.subtle",
      "label.gray.bg",
      "label.red.bg",
      "label.orange.bg",
      "label.yellow.bg",
      "label.green.bg",
      "label.teal.bg",
      "label.blue.bg",
      "label.indigo.bg",
      "label.purple.bg",
      "label.pink.bg",
      "code.bg",
      "code.inlineBg",
      "diff.addedBg",
      "diff.removedBg",
      "diff.hunkBg"
    ]
  },
  "pairs": [
    ["text.primary", "bg.base", 4.5],
    ["text.primary", "bg.grouped", 4.5],
    ["text.primary", "bg.raised", 4.5],
    ["text.primary", "bg.overlay", 4.5],
    ["text.secondary", "bg.base", 4.5],
    ["text.secondary", "bg.raised", 4.5],
    ["text.tertiary", "bg.base", 3],
    ["text.tertiary", "bg.grouped", 3],
    ["text.secondary", "bg.grouped", 4.5],
    ["text.inverse", "bg.inverse", 4.5],
    ["text.link", "bg.base", 4.5],
    ["text.onAccent", "accent.solid", 4.5],
    ["text.onAccent", "accent.pressed", 4.5],
    ["text.onDanger", "danger.solid", 4.5],
    ["accent.default", "bg.base", 3],
    ["text.disabled", "fill.disabled", 2],
    ["icon.primary", "bg.base", 3],
    ["icon.secondary", "bg.base", 3],
    ["accent.fg", "bg.base", 4.5],
    ["accent.onSubtle", "accent.subtle", 4.5],
    ["danger.default", "bg.base", 4.5],
    ["danger.onSubtle", "danger.subtle", 4.5],
    ["warning.default", "bg.base", 3],
    ["warning.onSubtle", "warning.subtle", 4.5],
    ["success.default", "bg.base", 3],
    ["success.onSubtle", "success.subtle", 4.5],
    ["info.default", "bg.base", 3],
    ["info.onSubtle", "info.subtle", 4.5],
    ["state.idle", "bg.base", 3],
