{
  "$description": "Dimensions in pt (iOS) = dp (Android), on a 4pt grid. Durations in ms.",
  "spacing": {
    "$type": "dimension",
    "none": { "$value": 0 },
    "xxs": { "$value": 2 },
    "xs": { "$value": 4 },
    "sm": { "$value": 8 },
    "md": { "$value": 12 },
    "lg": { "$value": 16 },
    "xl": { "$value": 20 },
    "xxl": { "$value": 24 },
    "xxxl": { "$value": 32 },
    "huge": { "$value": 48 }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": 4, "$description": "Inline code, small badges." },
    "sm": { "$value": 6, "$description": "Chips, checkboxes." },
    "md": { "$value": 10, "$description": "Buttons, text fields, code blocks." },
    "lg": { "$value": 14, "$description": "Cards, grouped list sections." },
    "xl": { "$value": 20, "$description": "Composer, sheets (custom)." },
    "full": { "$value": 9999, "$description": "Pills, avatars." }
  },
  "iconSize": {
    "$type": "dimension",
    "xs": { "$value": 12 },
    "sm": { "$value": 16, "$description": "Inline with footnote / caption text." },
    "md": { "$value": 20, "$description": "Default: list rows, toolbars." },
    "lg": { "$value": 24, "$description": "Tab bar, prominent actions." },
    "xl": { "$value": 28 }
  },
  "stroke": {
    "$type": "dimension",
    "default": { "$value": 1, "$description": "Outlines. List separators use the platform hairline instead." },
    "focus": { "$value": 2 },
    "icon": { "$value": 1.75, "$description": "Icon stroke on the 24pt grid; baked into generated icons." }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$value": 44, "$description": "Minimum hit area. Android Material reserves 48dp; we keep 44 visually and let Compose pad the hit area." },
    "controlSm": { "$value": 32 },
    "controlMd": { "$value": 40 },
    "controlLg": { "$value": 48 },
    "chip": { "$value": 28 },
    "listRow": { "$value": 48, "$description": "Single-line row minimum height." },
    "listRowTwoLine": { "$value": 64 },
    "sectionHeader": { "$value": 40 },
    "avatarSm": { "$value": 20 },
    "avatarMd": { "$value": 28 },
    "avatarLg": { "$value": 40 },
    "composerMin": { "$value": 48 }
  },
  "layout": {
    "$type": "dimension",
    "screenPaddingX": { "$value": 16, "$description": "Horizontal content inset on phones." },
    "listRowPaddingX": { "$value": 16 },
    "listRowPaddingY": { "$value": 12 },
    "listRowGap": { "$value": 12, "$description": "Leading icon to title." },
    "sectionGap": { "$value": 24 },
    "readableMaxWidth": { "$value": 680, "$description": "Max text column width on tablets / foldables." }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": 120, "$description": "Press feedback, toggles." },
      "base": { "$value": 200, "$description": "Expand / collapse, fades." },
      "slow": { "$value": 320, "$description": "Large content changes." }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.3, 0, 0, 1] }
    }
  }
}
