{
  "$description": "Semantic colors over the generated scales in palette.json, assigned by mobile platform conventions (iOS HIG semantic colors, Material 3 roles). A value is one reference used in both modes (\"{neutral.12}\") or { light, dark }. References: scale steps ({accent.9}, {accent.solid}), black / white, optionally with alpha percent ({black/40}).",
  "bg": {
    "$type": "color",
    "base": { "$value": "{neutral.1}", "$description": "Screen background for plain lists and content (iOS systemBackground)." },
    "grouped": { "$value": { "light": "{neutral.2}", "dark": "{neutral.1}" }, "$description": "Behind grouped lists and cards (iOS systemGroupedBackground)." },
    "raised": { "$value": { "light": "{neutral.1}", "dark": "{neutral.2}" }, "$description": "Cards and cells on bg.grouped, sheets, the composer (iOS secondarySystemGroupedBackground)." },
    "sunken": { "$value": { "light": "{black/5}", "dark": "{white/10}" }, "$description": "Text fields and search bars: a flat translucent fill (iOS search field), no inset." },
    "overlay": { "$value": { "light": "{neutral.1}", "dark": "{neutral.3}" }, "$description": "Custom menus, popovers and toasts; pair with an elevation." },
    "inverse": { "$value": "{neutral.12}", "$description": "Snackbars and tooltips; text uses text.inverse." }
  },
  "fill": {
    "$type": "color",
    "pressed": { "$value": "{neutral.4}", "$description": "Row / cell highlight while pressed on iOS. Android uses the platform ripple instead." },
    "selected": { "$value": { "light": "{black/8}", "dark": "{white/12}" }, "$description": "Persistently selected row, chip or segment. Translucent." },
    "secondary": { "$value": { "light": "{black/7}", "dark": "{white/12}" }, "$description": "Secondary buttons and neutral chips. Translucent like iOS tertiarySystemFill, so it reads on every surface." },
    "tertiary": { "$value": { "light": "{black/5}", "dark": "{white/8}" }, "$description": "Skeletons, avatar placeholders. Translucent." },
    "disabled": { "$value": "{neutral.3}", "$description": "Container of a disabled filled control (M3: on-surface 12%)." }
  },
  "text": {
    "$type": "color",
    "primary": { "$value": "{neutral.12}", "$description": "Titles and body copy (iOS label)." },
    "secondary": { "$value": "{neutral.11}", "$description": "Supporting copy, metadata (iOS secondaryLabel)." },
    "tertiary": { "$value": "{neutral.10}", "$description": "Section headers, timestamps. Short text only (iOS tertiaryLabel)." },
    "placeholder": { "$value": "{neutral.9}", "$description": "Field placeholders (iOS placeholderText)." },
    "disabled": { "$value": "{neutral.9}", "$description": "Text and icons of disabled controls (M3: on-surface 38%)." },
    "inverse": { "$value": "{neutral.1}", "$description": "Text on bg.inverse." },
    "onAccent": { "$value": "{white}", "$description": "Text and icons on accent.solid." },
    "onDanger": { "$value": "{white}", "$description": "Text and icons on danger.solid." },
    "link": { "$value": "{accent.11}" }
  },
  "icon": {
    "$type": "color",
    "primary": { "$value": "{neutral.12}" },
    "secondary": { "$value": "{neutral.10}" },
    "tertiary": { "$value": "{neutral.8}", "$description": "Decorative only, e.g. the section header plus." },
    "disabled": { "$value": "{neutral.8}" }
  },
  "border": {
    "$type": "color",
    "subtle": { "$value": { "light": "{neutral.6}", "dark": "{neutral.4}" }, "$description": "Hairline list separators, drawn at one physical pixel (iOS separator)." },
    "default": { "$value": { "light": "{neutral.6}", "dark": "{neutral.5}" }, "$description": "1pt outlines: filter chips, cards that need an edge." },
    "strong": { "$value": { "light": "{neutral.7}", "dark": "{neutral.6}" }, "$description": "Checkbox rings, emphasized outlines." },
    "focus": { "$value": "{accent.9}", "$description": "Focus ring for hardware keyboards." }
  },
  "accent": {
    "$type": "color",
    "$description": "Brand blue hsl(220 82% 65%); dark mode lifts the same hue. Works as the platform tint (iOS tint, M3 primary).",
    "default": { "$value": "{accent.9}", "$description": "Tint: switches, checkmarks, progress, selection, toolbar actions, running state." },
    "solid": { "$value": "{accent.solid}", "$description": "Filled primary buttons and the send button, with text.onAccent." },
    "pressed": { "$value": "{accent.solidPressed}", "$description": "accent.solid while pressed (iOS)." },
    "fg": { "$value": "{accent.11}", "$description": "Accent as readable foreground: selected tab label, accent text." },
    "subtle": { "$value": { "light": "{accent.9/12}", "dark": "{accent.9/20}" }, "$description": "Tinted background for accent chips and banners (M3 primary container)." },
    "onSubtle": { "$value": "{accent.11}" }
  },
  "danger": {
    "$type": "color",
    "default": { "$value": "{danger.11}", "$description": "Destructive icons and text, e.g. a destructive menu item." },
    "solid": { "$value": "{danger.solid}", "$description": "Filled destructive buttons, with text.onDanger." },
    "subtle": { "$value": { "light": "{danger.9/10}", "dark": "{danger.9/22}" } },
    "onSubtle": { "$value": "{danger.11}" }
  },
  "warning": {
    "$type": "color",
    "default": { "$value": { "light": "{warning.11}", "dark": "{warning.9}" }, "$description": "Icons and badges. The light brand orange is under 3:1 on white, so light uses the text step." },
    "subtle": { "$value": { "light": "{warning.9/14}", "dark": "{warning.9/20}" } },
    "onSubtle": { "$value": "{warning.11}" }
  },
  "success": {
    "$type": "color",
    "default": { "$value": "{success.9}" },
    "subtle": { "$value": { "light": "{success.9/12}", "dark": "{success.9/20}" } },
    "onSubtle": { "$value": "{success.11}" }
  },
  "info": {
    "$type": "color",
    "$description": "Neutral notices use the accent scale.",
    "default": { "$value": "{accent.9}" },
    "subtle": { "$value": { "light": "{accent.9/12}", "dark": "{accent.9/20}" } },
    "onSubtle": { "$value": "{accent.11}" }
  },
  "state": {
    "$type": "color",
    "$description": "Session status glyphs. Shape carries meaning too; color is never the only signal.",
    "idle": { "$value": "{neutral.10}", "$description": "Backlog / not started / archived." },
    "running": { "$value": "{accent.9}", "$description": "Agent working." },
    "waiting": { "$value": { "light": "{warning.11}", "dark": "{warning.9}" }, "$description": "Needs user input or approval." },
    "done": { "$value": "{success.9}" },
    "failed": { "$value": "{danger.9}" },
    "merged": { "$value": "{merged.9}", "$description": "Pull request merged." }
  },
  "label": {
    "$type": "color",
    "$description": "Categorical colors for project labels, tags and avatar backgrounds; hues generated to sit in the theme. fg reads on bg.base and on the matching bg.",
    "gray": { "fg": { "$value": "{neutral.11}" }, "bg": { "$value": { "light": "{black/6}", "dark": "{white/10}" } } },
    "red": { "fg": { "$value": "{red.11}" }, "bg": { "$value": { "light": "{red.9/14}", "dark": "{red.9/20}" } } },
    "orange": { "fg": { "$value": "{orange.11}" }, "bg": { "$value": { "light": "{orange.9/14}", "dark": "{orange.9/20}" } } },
    "yellow": { "fg": { "$value": "{yellow.11}" }, "bg": { "$value": { "light": "{yellow.9/14}", "dark": "{yellow.9/20}" } } },
    "green": { "fg": { "$value": "{green.11}" }, "bg": { "$value": { "light": "{green.9/14}", "dark": "{green.9/20}" } } },
    "teal": { "fg": { "$value": "{teal.11}" }, "bg": { "$value": { "light": "{teal.9/14}", "dark": "{teal.9/20}" } } },
    "blue": { "fg": { "$value": "{blue.11}" }, "bg": { "$value": { "light": "{blue.9/14}", "dark": "{blue.9/20}" } } },
    "indigo": { "fg": { "$value": "{indigo.11}" }, "bg": { "$value": { "light": "{indigo.9/14}", "dark": "{indigo.9/20}" } } },
    "purple": { "fg": { "$value": "{purple.11}" }, "bg": { "$value": { "light": "{purple.9/14}", "dark": "{purple.9/20}" } } },
    "pink": { "fg": { "$value": "{pink.11}" }, "bg": { "$value": { "light": "{pink.9/14}", "dark": "{pink.9/20}" } } }
  },
  "code": {
    "$type": "color",
    "bg": { "$value": { "light": "{black/5}", "dark": "{white/7}" }, "$description": "Code blocks and diffs. Translucent so a block reads on lists and cards alike." },
    "inlineBg": { "$value": { "light": "{black/7}", "dark": "{white/12}" }, "$description": "Inline `code` spans inside prose." },
    "text": { "$value": "{neutral.12}" },
    "border": { "$value": { "light": "{neutral.5}", "dark": "{neutral.4}" } },
    "gutter": { "$value": { "light": "{neutral.11}", "dark": "{neutral.10}" }, "$description": "Line numbers." }
  },
  "syntax": {
    "$type": "color",
    "$description": "Syntax highlighting on code.bg, drawn from the categorical scales so it follows the theme.",
    "keyword": { "$value": "{purple.11}" },
    "string": { "$value": "{green.11}" },
    "number": { "$value": "{orange.11}" },
    "constant": { "$value": "{blue.11}", "$description": "true / false / null and named constants." },
    "function": { "$value": "{indigo.11}" },
    "type": { "$value": "{teal.11}" },
    "variable": { "$value": "{neutral.12}" },
    "property": { "$value": "{red.11}", "$description": "Object keys, HTML / JSX attributes." },
    "tag": { "$value": "{pink.11}" },
    "comment": { "$value": { "light": "{neutral.11}", "dark": "{neutral.10}" } },
    "punctuation": { "$value": "{neutral.11}", "$description": "Operators and punctuation." }
  },
  "diff": {
    "$type": "color",
    "addedBg": { "$value": { "light": "{success.9/12}", "dark": "{success.9/18}" } },
    "removedBg": { "$value": { "light": "{danger.9/10}", "dark": "{danger.9/20}" } },
    "addedText": { "$value": "{success.11}" },
    "removedText": { "$value": "{danger.11}" },
    "hunkBg": { "$value": { "light": "{accent.9/10}", "dark": "{accent.9/14}" }, "$description": "@@ hunk header rows." },
    "hunkText": { "$value": "{accent.11}" }
  },
  "selection": {
    "$type": "color",
    "text": { "$value": { "light": "{accent.9/24}", "dark": "{accent.9/36}" }, "$description": "Selected-text highlight." },
    "handle": { "$value": "{accent.9}", "$description": "Caret and selection handles." }
  },
  "overlay": {
    "$type": "color",
    "scrim": { "$value": { "light": "{black/40}", "dark": "{black/60}" }, "$description": "Dimming behind custom modals." }
  },
  "shadow": {
    "$type": "color",
    "$description": "Shadow ink per elevation level (tokens/elevation.json); much stronger in dark mode to read on black.",
    "sm": { "$value": { "light": "{black/8}", "dark": "{black/40}" } },
    "md": { "$value": { "light": "{black/12}", "dark": "{black/50}" } },
    "lg": { "$value": { "light": "{black/16}", "dark": "{black/60}" } }
  }
}
