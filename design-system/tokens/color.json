{
  "$description": "Semantic colors. Each token has a light and a dark value: a palette reference ({indigo.600}), a reference with alpha percent ({indigo.600/12}), or #RRGGBB[AA]. Generated names are the camelCased path (bg.base -> bgBase).",
  "bg": {
    "$type": "color",
    "base": { "$value": { "light": "{gray.0}", "dark": "{gray.1000}" }, "$description": "Screen background for plain lists and content." },
    "grouped": { "$value": { "light": "{gray.50}", "dark": "{gray.1000}" }, "$description": "Screen background behind grouped (inset) lists and cards." },
    "raised": { "$value": { "light": "{gray.0}", "dark": "{gray.950}" }, "$description": "Cards on bg.grouped, sheets, the composer." },
    "sunken": { "$value": { "light": "{gray.50}", "dark": "{gray.950}" }, "$description": "Text fields and recessed wells on bg.base." },
    "overlay": { "$value": { "light": "{gray.0}", "dark": "{gray.900}" }, "$description": "Custom menus and popovers; pair with an elevation." },
    "inverse": { "$value": { "light": "{gray.850}", "dark": "{gray.100}" }, "$description": "Toasts and tooltips; text uses text.inverse." }
  },
  "fill": {
    "$type": "color",
    "pressed": { "$value": { "light": "{gray.100}", "dark": "{gray.925}" }, "$description": "Row / cell highlight while pressed (iOS). Android uses ripple." },
    "selected": { "$value": { "light": "{gray.150}", "dark": "{gray.850}" }, "$description": "Persistently selected row, chip or segment." },
    "secondary": { "$value": { "light": "{gray.100}", "dark": "{gray.900}" }, "$description": "Secondary buttons, neutral chips." },
    "tertiary": { "$value": { "light": "{gray.50}", "dark": "{gray.950}" }, "$description": "Quiet fills: skeletons, avatar placeholders, inline code." },
    "disabled": { "$value": { "light": "{gray.100}", "dark": "{gray.900}" }, "$description": "Background of a disabled filled control." }
  },
  "text": {
    "$type": "color",
    "primary": { "$value": { "light": "{gray.850}", "dark": "{gray.50}" }, "$description": "Titles and body copy." },
    "secondary": { "$value": { "light": "{gray.600}", "dark": "{gray.500}" }, "$description": "Supporting copy, metadata." },
    "tertiary": { "$value": { "light": "{gray.500}", "dark": "{gray.600}" }, "$description": "Section headers, timestamps. Short text only." },
    "placeholder": { "$value": { "light": "{gray.400}", "dark": "{gray.700}" }, "$description": "Field placeholders." },
    "disabled": { "$value": { "light": "{gray.300}", "dark": "{gray.750}" } },
    "inverse": { "$value": { "light": "{gray.0}", "dark": "{gray.900}" }, "$description": "Text on bg.inverse." },
    "onAccent": { "$value": { "light": "{white}", "dark": "{white}" }, "$description": "Text and icons on accent.default and danger.solid." },
    "link": { "$value": { "light": "{indigo.600}", "dark": "{indigo.400}" } }
  },
  "icon": {
    "$type": "color",
    "primary": { "$value": { "light": "{gray.800}", "dark": "{gray.150}" } },
    "secondary": { "$value": { "light": "{gray.500}", "dark": "{gray.500}" } },
    "tertiary": { "$value": { "light": "{gray.400}", "dark": "{gray.700}" }, "$description": "Decorative only, e.g. the section header plus." },
    "disabled": { "$value": { "light": "{gray.300}", "dark": "{gray.750}" } }
  },
  "border": {
    "$type": "color",
    "subtle": { "$value": { "light": "{gray.100}", "dark": "{gray.900}" }, "$description": "Hairline list separators." },
    "default": { "$value": { "light": "{gray.150}", "dark": "{gray.850}" }, "$description": "Card and field outlines." },
    "strong": { "$value": { "light": "{gray.300}", "dark": "{gray.750}" }, "$description": "Checkbox rings, emphasized outlines." },
    "focus": { "$value": { "light": "{indigo.500}", "dark": "{indigo.400}" }, "$description": "Focus ring for hardware keyboards." }
  },
  "accent": {
    "$type": "color",
    "default": { "$value": { "light": "{indigo.600}", "dark": "{indigo.600}" }, "$description": "Primary buttons, send button, switches." },
    "pressed": { "$value": { "light": "{indigo.700}", "dark": "{indigo.700}" } },
    "fg": { "$value": { "light": "{indigo.700}", "dark": "{indigo.400}" }, "$description": "Accent as foreground: selected tab, active icon." },
    "subtle": { "$value": { "light": "{indigo.600/10}", "dark": "{indigo.500/20}" }, "$description": "Tinted background for accent chips and banners." },
    "onSubtle": { "$value": { "light": "{indigo.700}", "dark": "{indigo.300}" }, "$description": "Text and icons on accent.subtle." }
  },
  "danger": {
    "$type": "color",
    "default": { "$value": { "light": "{red.600}", "dark": "{red.500}" }, "$description": "Destructive icons and text." },
    "solid": { "$value": { "light": "{red.600}", "dark": "{red.600}" }, "$description": "Filled destructive buttons, with text.onAccent." },
    "subtle": { "$value": { "light": "{red.600/10}", "dark": "{red.500/18}" } },
    "onSubtle": { "$value": { "light": "{red.700}", "dark": "{red.300}" } }
  },
  "warning": {
    "$type": "color",
    "default": { "$value": { "light": "{orange.500}", "dark": "{orange.400}" }, "$description": "Icons and badges; body text goes on warning.subtle with warning.onSubtle." },
    "subtle": { "$value": { "light": "{orange.500/12}", "dark": "{orange.400/16}" } },
    "onSubtle": { "$value": { "light": "{orange.700}", "dark": "{orange.300}" } }
  },
  "success": {
    "$type": "color",
    "default": { "$value": { "light": "{green.600}", "dark": "{green.400}" } },
    "subtle": { "$value": { "light": "{green.600/10}", "dark": "{green.400/16}" } },
    "onSubtle": { "$value": { "light": "{green.700}", "dark": "{green.300}" } }
  },
  "info": {
    "$type": "color",
    "default": { "$value": { "light": "{blue.600}", "dark": "{blue.400}" } },
    "subtle": { "$value": { "light": "{blue.600/10}", "dark": "{blue.400/16}" } },
    "onSubtle": { "$value": { "light": "{blue.700}", "dark": "{blue.300}" } }
  },
  "state": {
    "$type": "color",
    "$description": "Session / task status glyphs, following Linear's workflow colors (In Progress yellow, Done green-or-indigo, Canceled gray). Shape carries meaning too; color is never the only signal.",
    "idle": { "$value": { "light": "{gray.500}", "dark": "{gray.600}" }, "$description": "Backlog / not started / archived." },
    "running": { "$value": { "light": "{yellow.500}", "dark": "{yellow.300}" }, "$description": "Agent working (Linear: In Progress)." },
    "waiting": { "$value": { "light": "{orange.500}", "dark": "{orange.400}" }, "$description": "Needs user input or approval." },
    "done": { "$value": { "light": "{green.600}", "dark": "{green.400}" } },
    "failed": { "$value": { "light": "{red.600}", "dark": "{red.500}" } },
    "merged": { "$value": { "light": "{purple.600}", "dark": "{purple.400}" }, "$description": "Pull request merged (GitHub convention)." }
  },
  "label": {
    "$type": "color",
    "$description": "Categorical colors for project labels, tags and avatar backgrounds. fg works as text / icon on bg.base and on the matching bg.",
    "gray": {
      "fg": { "$value": { "light": "{gray.700}", "dark": "{gray.500}" } },
      "bg": { "$value": { "light": "{gray.500/12}", "dark": "{gray.500/20}" } }
    },
    "red": {
      "fg": { "$value": { "light": "{red.700}", "dark": "{red.400}" } },
      "bg": { "$value": { "light": "{red.500/12}", "dark": "{red.400/16}" } }
    },
    "orange": {
      "fg": { "$value": { "light": "{orange.700}", "dark": "{orange.400}" } },
      "bg": { "$value": { "light": "{orange.500/12}", "dark": "{orange.400/16}" } }
    },
    "yellow": {
      "fg": { "$value": { "light": "{yellow.700}", "dark": "{yellow.300}" } },
      "bg": { "$value": { "light": "{yellow.400/14}", "dark": "{yellow.300/14}" } }
    },
    "green": {
      "fg": { "$value": { "light": "{green.700}", "dark": "{green.400}" } },
      "bg": { "$value": { "light": "{green.500/12}", "dark": "{green.400/16}" } }
    },
    "teal": {
      "fg": { "$value": { "light": "{teal.700}", "dark": "{teal.400}" } },
      "bg": { "$value": { "light": "{teal.500/12}", "dark": "{teal.400/16}" } }
    },
    "blue": {
      "fg": { "$value": { "light": "{blue.700}", "dark": "{blue.400}" } },
      "bg": { "$value": { "light": "{blue.500/12}", "dark": "{blue.400/16}" } }
    },
    "indigo": {
      "fg": { "$value": { "light": "{indigo.700}", "dark": "{indigo.400}" } },
      "bg": { "$value": { "light": "{indigo.500/12}", "dark": "{indigo.400/18}" } }
    },
    "purple": {
      "fg": { "$value": { "light": "{purple.700}", "dark": "{purple.400}" } },
      "bg": { "$value": { "light": "{purple.500/12}", "dark": "{purple.400/16}" } }
    },
    "pink": {
      "fg": { "$value": { "light": "{pink.700}", "dark": "{pink.400}" } },
      "bg": { "$value": { "light": "{pink.500/12}", "dark": "{pink.400/16}" } }
    }
  },
  "code": {
    "$type": "color",
    "bg": { "$value": { "light": "{gray.50}", "dark": "{gray.950}" }, "$description": "Code blocks and diffs." },
    "inlineBg": { "$value": { "light": "{gray.100}", "dark": "{gray.900}" }, "$description": "Inline `code` spans inside prose." },
    "text": { "$value": { "light": "{gray.850}", "dark": "{gray.100}" } },
    "border": { "$value": { "light": "{gray.150}", "dark": "{gray.850}" } },
    "gutter": { "$value": { "light": "{gray.500}", "dark": "{gray.600}" }, "$description": "Line numbers." }
  },
  "syntax": {
    "$type": "color",
    "$description": "Syntax highlighting on code.bg.",
    "keyword": { "$value": { "light": "{purple.600}", "dark": "{purple.300}" } },
    "string": { "$value": { "light": "{green.700}", "dark": "{green.300}" } },
    "number": { "$value": { "light": "{orange.700}", "dark": "{orange.300}" } },
    "constant": { "$value": { "light": "{indigo.700}", "dark": "{indigo.300}" }, "$description": "true / false / null and named constants." },
    "function": { "$value": { "light": "{blue.700}", "dark": "{blue.300}" } },
    "type": { "$value": { "light": "{teal.700}", "dark": "{teal.300}" } },
    "variable": { "$value": { "light": "{gray.850}", "dark": "{gray.100}" } },
    "property": { "$value": { "light": "{red.700}", "dark": "{red.300}" }, "$description": "Object keys, HTML / JSX attributes." },
    "tag": { "$value": { "light": "{pink.700}", "dark": "{pink.300}" } },
    "comment": { "$value": { "light": "{gray.500}", "dark": "{gray.600}" } },
    "punctuation": { "$value": { "light": "{gray.600}", "dark": "{gray.500}" }, "$description": "Operators and punctuation." }
  },
  "diff": {
    "$type": "color",
    "addedBg": { "$value": { "light": "{green.500/12}", "dark": "{green.400/14}" } },
    "removedBg": { "$value": { "light": "{red.500/10}", "dark": "{red.500/16}" } },
    "addedText": { "$value": { "light": "{green.700}", "dark": "{green.300}" } },
    "removedText": { "$value": { "light": "{red.700}", "dark": "{red.300}" } },
    "hunkBg": { "$value": { "light": "{indigo.500/8}", "dark": "{indigo.500/14}" }, "$description": "@@ hunk header rows." },
    "hunkText": { "$value": { "light": "{indigo.700}", "dark": "{indigo.300}" } }
  },
  "selection": {
    "$type": "color",
    "text": { "$value": { "light": "{indigo.500/22}", "dark": "{indigo.500/40}" }, "$description": "Selected-text highlight." },
    "handle": { "$value": { "light": "{indigo.600}", "dark": "{indigo.400}" }, "$description": "Caret and selection handles." }
  },
  "overlay": {
    "$type": "color",
    "scrim": { "$value": { "light": "{black/40}", "dark": "{black/60}" }, "$description": "Dimming behind custom modals." }
  },
  "shadow": {
    "$type": "color",
    "$description": "Shadow colors per elevation level (tokens/elevation.json). Dark mode needs much stronger shadows to read on near-black.",
    "sm": { "$value": { "light": "{black/6}", "dark": "{black/40}" } },
    "md": { "$value": { "light": "{black/10}", "dark": "{black/50}" } },
    "lg": { "$value": { "light": "{black/14}", "dark": "{black/60}" } }
  }
}
